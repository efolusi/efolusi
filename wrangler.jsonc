{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "efolusi",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  // The Worker serves the custom domains; Cloudflare makes their DNS records and certificates.
  "routes": [
    { "pattern": "efolusi.com", "custom_domain": true },
    { "pattern": "www.efolusi.com", "custom_domain": true }
  ],
  // BREVO_API_KEY, EMAIL_FROM and EMAIL_TO come from the production environment
  // secrets; deploy.yml uploads them with the deploy (--secrets-file).
  "vars": {
    "EFOLUSI_EXTERNAL_ORIGIN": "https://efolusi.com"
  },
  // 5 requests per 60 s per client IP, the same limit the PM2 build kept in memory.
  "ratelimits": [
    { "name": "CONTACT_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "NEWSLETTER_RATE_LIMIT", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }
  ]
}
