{
    "name": "efolusi",
    "private": true,
    "version": "0.0.4",
    "packageManager": "pnpm@11.24.0",
    "description": "Efolusi landing page built with Next.js and the Meridian design system.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/efolusi/efolusi.git"
    },
    "homepage": "https://efolusi.com",
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "test": "vitest run",
        "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
        "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
        "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
    },
    "dependencies": {
        "@efolusi/meridian": "^1.25.0",
        "@opennextjs/cloudflare": "1.20.17",
        "next": "^15.5.24",
        "react": "18.3.1",
        "react-dom": "18.3.1"
    },
    "engines": {
        "node": "26.13.1"
    },
    "devDependencies": {
        "vitest": "^2.1.9",
        "wrangler": "4.164.0"
    }
}
